@model List<BookingApiViewModel.Result>
@{
    Layout = null;
    int count = 0;
}
<div class="container">
    <br /><br />
@using (Html.BeginForm("Index", "BookingByCity", FormMethod.Post))
{
    <label>Enter your City ID Information</label>
    <input type="text" class="form-control" name="cityID" />
    <br />
    <button class="btn btn-primary">List Hotels for the City</button>
}


<br />
<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <table class="table table-bordered">
        <tr>
            <th>#</th>
            <th>Hotel Name</th>
            <th>Hotel Score</th>
            <th>Hotel Details</th>

        </tr>
        @foreach (var item in Model)
        {
            count++;
            <tr>
                <th>@count</th>
                <td>@item.hotel_name</td>
                <td>@item.review_score</td>
                <td><a href="#" class="btn btn-outline-dark">Details</a></td>
            </tr>
        }
    </table>

</div>