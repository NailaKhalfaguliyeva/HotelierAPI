@model List<BookingLocationSearchViewModel>
@{
    Layout = null;
}

<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
<div class="container">
    <br />
    @using (Html.BeginForm("Index", "SearchLocationID", FormMethod.Post))
    {
        <label>Enter the city name.</label>
        <input type="text" class="form-control" name="cityName" />
        <br />
        <button class="btn btn-primary">Finding ID for the city</button>
    }
    <table class="table table-bordered">
        <tr>
            <th>Location</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.dest_id</td>
            </tr>
        }
    </table>
    <br />
    <a href="/BookingByCity/Index/"class="btn btn-dark">New Hotel Reservation Information</a>
</div>