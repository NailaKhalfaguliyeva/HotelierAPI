@model CreateAboutDto
@{
    ViewData["Title"] = "AddAbout";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}

<form method="post">
    <label>Title1</label>
    <input type="text" asp-for="Title1" class="form-control" />
    <span asp-validation-for="Title1" class="text-danger"></span>
    <br />

    <label>Title2</label>
    <input type="text" asp-for="Title2" class="form-control" />
    <span asp-validation-for="Title2" class="text-danger"></span>
    <br />

    <label>Content</label>
    <textarea asp-for="Content" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Content" class="text-danger"></span>
    <br />

    <label>RoomCount</label>
    <input type="number" asp-for="RoomCount" class="form-control" />
    <br />

    <label>StaffCount</label>
    <input type="number" asp-for="StaffCount" class="form-control" />
    <br />

    <label>CustomerCount</label>
    <input type="number" asp-for="CustomerCount" class="form-control" />
    <br />

    <button class="btn btn-primary">Add About</button>
</form>

