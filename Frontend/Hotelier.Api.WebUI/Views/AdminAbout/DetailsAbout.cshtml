@model ResultAboutDto
@{
    ViewData["Title"] = "DetailsAbout";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-body">
        <h4>@Model.Title1</h4>
        <h6 class="text-muted">@Model.Title2</h6>
        <hr />
        <p>@Model.Content</p>

        <ul>
            <li><b>Rooms:</b> @Model.RoomCount</li>
            <li><b>Staff:</b> @Model.StaffCount</li>
            <li><b>Customers:</b> @Model.CustomerCount</li>
        </ul>

        <a href="/AdminAbout/UpdateAbout/@Model.AboutID" class="btn btn-outline-success">Update</a>
        <a href="/AdminAbout/Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>
