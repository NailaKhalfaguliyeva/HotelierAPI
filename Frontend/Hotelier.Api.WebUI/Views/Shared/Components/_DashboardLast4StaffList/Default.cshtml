@model List<ResultLast4StaffDto>
<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-lg-3 col-sm-6">
            <div class="card">
                <div class="card-body">
                    <div class="text-center">
       
                            <img class="img-fluid flex-shrink-0 rounded" src="@item.ImageUrl" style="width: 45px; height: 45px;">

                        <h5 class="mt-3 mb-1">@item.Name</h5>
                        <p class="m-0">@item.Title</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>