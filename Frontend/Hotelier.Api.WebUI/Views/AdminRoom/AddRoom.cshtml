@model CreateRoomDto
@{
    ViewData["Title"] = "AddRoom";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}
<form method="post">
    <label>Room Number</label>
    <input type="text" asp-for="RoomNumber" class="form-control" />
    <span asp-validation-for="RoomNumber" class="text-danger"></span>
    <br />
    <label>Room Header</label>
    <input type="text" asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
    <br />
    <label>Price</label>
    <input type="number" asp-for="Price" class="form-control" />
    <span asp-validation-for="Price" class="text-danger"></span>
    <br />
    <label>Number of Bedrooms</label>
    <input type="text" asp-for="BedCount" class="form-control" />
    <br />
    <label>Number of Bathrooms</label>
    <input type="text" asp-for="BathCount" class="form-control" />
    <br />
    <label>Wi-Fi</label>
    <input type="text" asp-for="Wifi" class="form-control" />
    <br />
    <label>Room Cover Photo</label>
    <input type="text" asp-for="RoomCoverImage" class="form-control" />
    <span asp-validation-for="RoomCoverImage" class="text-danger"></span>
    <br />
    <label>Description</label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
    <br />
    <button class="btn btn-primary">Add New Room</button>
</form>
