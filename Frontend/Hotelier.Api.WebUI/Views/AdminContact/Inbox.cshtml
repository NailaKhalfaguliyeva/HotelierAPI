@model List<InboxContactDto>
@{
    ViewData["Title"] = "Inbox";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="row">
    <!-- LEFT SIDEBAR -->
    <div class="col-lg-3">
        <div class="email-left-box">
            <a href="/AdminContact/AddSendMessage/" class="btn btn-primary btn-block">Create New Message</a>


            <div class="mail-list mt-4">
                <a href="/AdminContact/Inbox/" class="list-group-item border-0 text-primary p-r-0"><i class="fa fa-inbox font-18 align-middle mr-2"></i> <b>Inbox</b> <span class="badge badge-primary badge-sm float-right m-t-5">@ViewBag.contactCount</span> </a>

                <a href="/AdminContact/Sendbox/" class="list-group-item text-success border-0 text-info p-r-0"><i class="fa fa-paper-plane font-18 align-middle mr-2"></i><b>Outbox </b><span class="badge badge-info badge-sm float-right m-t-5">@ViewBag.sendMessageCount</span></a>

                <a href="#" class="list-group-item border-0 text-danger p-r-0"><i class="fa fa-star-o font-18 align-middle mr-2"></i><b>Important</b> <span class="badge badge-danger badge-sm float-right m-t-5">50</span> </a>

                <a href="#" class="list-group-item border-0 text-warning p-r-0"><i class="mdi mdi-file-document-box font-18 align-middle mr-2"></i><b>Draft</b> <span class="badge badge-warning badge-sm float-right m-t-5">18</span> </a>

                <a href="#" class="list-group-item border-0 text-dark p-r-0"><i class="fa fa-trash font-18 align-middle mr-2"></i><b>Trash</b><span class="badge badge-dark badge-sm float-right m-t-5">36</span></a>

            </div>
        </div>

    </div>

    <!-- RIGHT CONTENT -->
    <div class="col-lg-9">
        <div class="email-right-box">

            <!-- TOOLBAR -->
            <div role="toolbar" class="toolbar mb-3">
                <div class="btn-group">
                    <button type="button"
                            class="btn btn-dark dropdown-toggle"
                            data-toggle="dropdown"
                            aria-expanded="false">
                        Incoming Messages
                        <span class="caret m-l-5"></span>
                    </button>

                    <div class="dropdown-menu">
                        <a href="javascript:void(0);" class="dropdown-item">
                            Add Star
                        </a>
                        <a href="javascript:void(0);" class="dropdown-item">
                            Mute
                        </a>
                    </div>
                </div>
            </div>

            <!-- EMAIL LIST -->
            <div class="email-list">

                @foreach (var item in Model)
                {
                    <div class="message">
                        <a href="/AdminContact/MessageDetailsByInbox/@item.ContactID">
                            <div class="col-mail col-mail-1">
                                <div class="email-checkbox">
                                    <input type="checkbox" id="chk_@item.ContactID">
                                    <label class="toggle" for="chk_@item.ContactID"></label>
                                </div>
                                <span class="star-toggle ti-star"></span>
                            </div>

                            <div class="col-mail col-mail-2">
                                @if (!string.IsNullOrEmpty(item.Message))
                                {
                                    if (item.Message.Length <= 100)
                                    {
                                        <div class="subject">@item.Message</div>
                                    }
                                    else
                                    {
                                        <div class="subject">
                                            @item.Message.Substring(0, 100)...
                                        </div>
                                    }
                                }

                                <div class="date">
                                    @item.Date.ToString("HH:mm")
                                </div>
                            </div>
                        </a>
                    </div>
                }

            </div>
        </div>
    </div>
</div>