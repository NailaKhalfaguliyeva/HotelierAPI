@model List<InboxContactDto>
@{
    ViewData["Title"] = "Inbox";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}
            <div class="email-left-box">
                <a href="/AdminContact/AddSendMessage/" class="btn btn-primary btn-block">Create New Message</a>
                @await Component.InvokeAsync("SideBarAdminContactPartial")
                <h5 class="mt-5 m-b-10">Categories</h5>
                @await Component.InvokeAsync("SideBarAdminContactCategoryPartial")
            </div>
            <div class="email-right-box">
                <div role="toolbar" class="toolbar">
                    <div class="btn-group">
                        <button aria-expanded="false" data-toggle="dropdown" class="btn btn-dark dropdown-toggle" type="button">
                            Incoming Messages <span class="caret m-l-5"></span>
                        </button>                                                                                                                                                                   class="dropdown-item">Add Star</a>  <a href="javascript: void(0);" class="dropdown-item">Mute</a>
                    </div>
                </div>
            </div>
            <div class="email-list m-t-15">
                @foreach (var item in Model)
                {
                    <div class="message">
                        <a href="/AdminContact/MessageDetailsByInbox/@item.ContactID">
                            <div class="col-mail col-mail-1">
                                <div class="email-checkbox">
                                    <input type="checkbox" id="chk2">
                                    <label class="toggle" for="chk2"></label>
                                </div><span class="star-toggle ti-star"></span>
                            </div>
                            <div class="col-mail col-mail-2">
                                <div class="subject">@item.Message.Substring(0,100)</div>
                                <div class="date">11:49 am</div>
                            </div>
                        </a>
                    </div>
                }
            </div>
                    </div>